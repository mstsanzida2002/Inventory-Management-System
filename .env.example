DJANGO_SECRET_KEY=replace-with-a-generated-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=stockwell_dev
DB_USER=stockwell_dev
DB_PASSWORD=replace-with-your-local-postgres-role-password
DB_HOST=localhost
DB_PORT=5432

MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=300

# Email (Phase 8.99f-6/f-7) — backend-agnostic on purpose. EMAIL_BACKEND
# and DEFAULT_FROM_EMAIL are deliberately OMITTED here, not set to an
# empty value: os.environ.get(KEY, default) only falls through to
# config/settings.py's own default (console backend, sends nothing real)
# when the key is genuinely absent — KEY= (present but empty) would
# override that default with an empty string and crash on an empty
# import path. Add both yourself, with real values, only once you want
# real delivery as your resting default. `manage.py test` is unaffected
# either way — it always forces the in-memory locmem backend regardless
# of what's set here (belt-and-suspenders guard also in settings.py).
# EMAIL_HOST/PORT/USE_TLS/TIMEOUT below are safe to leave as-is (no
# secret, Gmail's own fixed values); EMAIL_HOST_USER/PASSWORD stay blank
# — fill in per docs/ENVIRONMENT.md's "Gmail App Password Setup" section
# (a 16-char App Password with 2FA enabled, never your real account
# password) alongside EMAIL_BACKEND/DEFAULT_FROM_EMAIL above.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
